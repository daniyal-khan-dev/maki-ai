# Copy this file to .env and fill in the two keys.

# Deepgram: listening (speech-to-text) and Maki's voice (text-to-speech).
# Free: new accounts get $200 of credit at https://console.deepgram.com
DEEPGRAM_API_KEY=

# The AI that writes Maki's answers. Any OpenAI-compatible chat API works.
# Default: Mistral's free "Experiment" plan, https://console.mistral.ai
LLM_API_KEY=
LLM_BASE_URL=https://api.mistral.ai/v1
LLM_MODEL=open-mistral-nemo
# Maths, physics, chemistry and computing questions use this one (best at teaching formulas).
# Leave it empty to always use LLM_MODEL.
FORMULA_MODEL=ministral-8b-latest
# Other free options:
#   Groq:   LLM_BASE_URL=https://api.groq.com/openai/v1   LLM_MODEL=llama-3.1-8b-instant
#   Gemini: LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai   LLM_MODEL=gemini-2.5-flash-lite
#   (with Groq or Gemini, set FORMULA_MODEL= empty, since ministral-8b is a Mistral model)

# Optional
PORT=3010
# Default voice for Maki (the page can switch it per conversation). Luna is friendly and natural;
# the page also offers Helena, Minerva, Delia, Andromeda, Apollo, Arcas, and British Pandora and Draco.
TTS_VOICE=aura-2-luna-en
# Default listening language (the page can switch it per conversation):
#   en    = English only, always written in English (recommended)
#   multi = English mixed with Urdu/Hindi; with some accents it switches language on plain English
STT_LANGUAGE=en
# Names and words the listening should catch (comma-separated).
KEYTERMS=Maki
# Silence (ms) that ends the student's turn. Lower = faster replies, higher = fewer cut-offs.
END_OF_TURN_MS=400
# Backup end of turn: words heard and the mic quiet for this long (Deepgram's own signal is sometimes late).
STABLE_TURN_MS=1200
# Mic loudness (16-bit RMS) that counts as speaking, for the backup above.
VOICE_RMS=350
# Extra wait (ms) when the listening says "finished" but the sentence has no . ? ! at the end.
NO_PUNCTUATION_WAIT_MS=900
# Longest turn, in sentences (one more when Maki gives a formula). Short turns sound natural.
MAX_SENTENCES=3
# Agentic workflow: the decision maker hands each question to an expert teacher (Mistral Agents API).
# AGENTIC=false answers directly with one model instead.
AGENTIC=true
# The decision maker's model. ministral-3b-latest is ~0.3 s faster but picks the right teacher less often.
ROUTER_MODEL=open-mistral-nemo
