{
  "name": "maki-voice-demo",
  "version": "0.1.0",
  "private": true,
  "description": "Two-way voice demo for Maki: Deepgram live listening -> streamed AI answer -> Deepgram voice, with interruptions.",
  "type": "module",
  "scripts": {
    "start": "tsx server.ts",
    "build": "vite build",
    "serve": "tsx server.ts --prod",
    "check": "tsc -p tsconfig.json && tsc -p client/tsconfig.json",
    "test:turn": "tsx scripts/test-turn.ts",
    "test:formulas": "tsx scripts/test-formulas.ts",
    "test:echo": "tsx scripts/test-echo.ts",
    "test:agents": "tsx scripts/test-agents.ts",
    "agents:delete": "tsx scripts/delete-agents.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@vitejs/plugin-react": "4.7.0",
    "dotenv": "16.4.7",
    "express": "4.21.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tsx": "4.23.15",
    "vite": "5.4.21",
    "ws": "8.18.0"
  },
  "devDependencies": {
    "@types/express": "4.17.21",
    "@types/node": "20.16.11",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@types/ws": "8.18.1",
    "typescript": "5.6.3"
  }
}
